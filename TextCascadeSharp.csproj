<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TextCascade</AssemblyName>
    <RootNamespace>TextCascadeSharp</RootNamespace>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <InformationalVersion>2.2.0.0</InformationalVersion>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 long45343</Copyright>
    <SelfContained>false</SelfContained>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- ApplicationConfiguration.Initialize() 读取这些属性 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>"Segoe UI", 9pt</ApplicationDefaultFont>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\app.ico" />
    <EmbeddedResource Include="assets\tray.ico" />
  </ItemGroup>

  <!-- SDK 默认会递归 glob 所有 .cs 文件，需排除 tests 子目录下的测试代码
       以免被主项目编译，导致 Fact/Theory 等 xUnit 类型找不到；
       tools 下的 e2e_verify.cs 是独立 file-based 应用（dotnet run file 参数运行），同样排除 -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
    <Compile Remove="tools\**\*.cs" />
    <None Remove="tools\**\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TextCascadeSharp.Tests" />
  </ItemGroup>
</Project>

